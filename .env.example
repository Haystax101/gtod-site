# ---- Front end (Vite, baked in at build time) ----
# Convex client URL. `npx convex dev` writes the dev one into .env.local automatically.
VITE_CONVEX_URL=
# Clerk publishable key (pk_test_... / pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=
# PostHog (optional). Leave unset and analytics stays off.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
# Voice (Gemini Live). Model id from `tools/voice/list-live-models.sh`.
# VITE_VOICE_WS_URL has a working default - only set it here to override.
VITE_VOICE_MODEL=
VITE_VOICE_WS_URL=

# ---- Backend (set with `npx convex env set`, not here) ----
# CLERK_JWT_ISSUER_DOMAIN   Issuer from the Clerk JWT template named "convex"
# OPENROUTER_API_KEY        Chat and coaching (all tiers)
# OPENROUTER_MODEL_FLASH    Free tier model slug
# OPENROUTER_MODEL_PRO      Pro tier model slug
# GEMINI_API_KEY            Voice (Gemini Live)
# EMBEDDINGS_API_KEY        Vector search. Reuse the Gemini key: Google's
#                           OpenAI-compatible endpoint returns 1536-wide
#                           vectors, which is what the schema declares, so no
#                           extra account and no code change.
# EMBEDDINGS_URL            https://generativelanguage.googleapis.com/v1beta/openai/embeddings
# EMBEDDINGS_MODEL          gemini-embedding-001
# EMBEDDINGS_DIMENSIONS     1536, and it must match EMBEDDING_DIMENSIONS in
#                           convex/schema.ts. Changing it means re-embedding.
# VOICE_USD_PER_MINUTE      Defaults to 0.023, verified for gemini-3.1-flash-live-preview
# STRIPE_SECRET_KEY         sk_test_... / sk_live_...
# STRIPE_PRICE_ID           price_... for Charge Pro (£10/month)
# STRIPE_WEBHOOK_SECRET     whsec_... for the endpoint https://<deployment>.convex.site/stripe/webhook
# SITE_URL                  https://getthereoneday.com (used for Stripe redirects)
